package day9

import (
	"fmt"
	"strconv"
	"adventofcode/m/v2/util"
	"strings"
	"sort"
)

func Day9(inputFile string, part int) {
	if part == 0 {
		fmt.Printf("Largest area: %d\n", findLargest(inputFile, false))
	} else {
		fmt.Printf("Largest area: %d\n", findLargest(inputFile, true))
	}
}

var MAX int // Tracks the largest X-index
func findLargest(inputFile string, areaContained bool) int {
	ls := util.LineScanner(inputFile)
	line, ok := util.Read(ls)

	pts := []*Point{}
	for ok {
		parts := strings.Split(line, ",")
		x, _ := strconv.Atoi(parts[0])
		y, _ := strconv.Atoi(parts[1])
		if x > MAX {
			MAX = x
		}
		pts = append(pts, &Point{x, y})
		line, ok = util.Read(ls)
	}
	
	// We take the corner point between segment pts[0]-pts[1] and pts[1]-pts[2]; flood from there
	p := &Point{pts[1].x, pts[1].y}
	if pts[0].x == pts[1].x { // first segment is vertical
		if pts[2].y > pts[1].y { 
			// |
			// | .
			// -----
			p.x++
			p.y--
		} else {
			//     |
			//   . |
			// -----
			p.x--
			p.y--
		}
	} else { // first segment is horizontal
			// -----
			//   . |
			//     |
		if pts[2].y > pts[1].y {
			p.x--
			p.y++
		} else {
			// -----
			// | .
			// |
			p.x++
			p.y++
		}
	}
	fmt.Printf("FLOOD FROM %d,%d\n", p.x, p.y)
		
	pgn, boxes := uncontained(pts)
	if areaContained {
		pgn.flood(p)
		return pgn.maxContained(boxes)
	} 
		
	return boxes[0].area()
}

// Returns the polygon and all boxes in a sorted list, by descending area
func uncontained(pts []*Point) (*Polygon, []*Box) {
	pgn := makePolygon(pts)
	boxes := []*Box{}
	max := 0
	for i := 0; i < len(pts); i++ {
		for j := 0; j < len(pts); j++ {
			if i == j {
				continue
			}
			b := &Box{pts[i],pts[j]}
			boxes = append(boxes, b)
			if b.area() > max {
				max = b.area() 
			}
		}
	}

	sort.Slice(boxes, func(i, j int) bool {
		return boxes[i].area() > boxes[j].area()
	})

	return pgn, boxes
}

// =======
// POLYGON 
// =======
type Polygon struct {
	vertSegments []*Segment
	horizSegments []*Segment
	memo map[int]map[int]bool 
}

func makePolygon(pts []*Point) *Polygon {
	vertSegments := []*Segment{}
	horizSegments := []*Segment{}
	for i := 0; i < len(pts)-1; i++ {
		if pts[i].x == pts[i+1].x { // Vertical segment, matching x
			vertSegments = append(vertSegments, &Segment{pts[i], pts[i+1]})
		} else {
			horizSegments = append(horizSegments, &Segment{pts[i], pts[i+1]})
		}
	}

	if pts[len(pts)-1].x == pts[0].x { // Vertical segment, matching x
		vertSegments = append(vertSegments, &Segment{pts[len(pts)-1], pts[0]})
	} else {
		horizSegments = append(horizSegments, &Segment{pts[len(pts)-1], pts[0]})
	}
	
	return &Polygon{
		vertSegments: vertSegments, 
		horizSegments: horizSegments, 
		memo: make(map[int]map[int]bool),
	}
}

// Floods from point p which we know to be inside the polygon
// This updates the memo map of the polygon until it contains all points
// both inside and on the edge of the polygon
func (pgn *Polygon) flood(p *Point) {
	// We check every neighbour of p. 
	// If it's on a border, we add it and stop. If it's not on a border, we add it
	// and flood from there.
	for i := -1; i <= 1; i++ {
		for j := -1; j <= 1; j++ {
			if i == 0 && j == 0 {
				continue
			}
			q := &Point{p.x+i, p.y+j}
			if pgn.onBorder(q) {
				pgn.memorize(q)
			} else {
				alreadyPresent := pgn.memorize(q)
				if !alreadyPresent {
					pgn.flood(q)
				}
			}
		}
	}

	return
}

// ..............
// .......#XXX#..
// .......X...X..
// ..#XXXX#...X..
// ..X........X..
// ..#XXXXXX#.X..
// .........X.X..
// .........#X#..
// ..............
func (pgn *Polygon) maxContained(boxes []*Box) int {
	for i, b := range boxes { // This is sorted in descending order
		 fmt.Printf("%d/%d\n", i, len(boxes))
		 if pgn.containsBox(b.p, b.q) {
			 return b.area() // Break on the first box that is contained because the list is sorted
		 }
	}
	return -1
}

func (pgn *Polygon) containsBox(p *Point, q *Point) bool {
  // We simply check if any point on the box border lies 
	// outside the polygon
	a := &Point{p.x, p.y}
	b := &Point{p.x, q.y}
	c := &Point{q.x, p.y}
	d := &Point{q.x, q.y}

	if !pgn.containsSegment(&Segment{a,b}) || 
	!pgn.containsSegment(&Segment{b,c}) || 
	!pgn.containsSegment(&Segment{c,d}) || 
	!pgn.containsSegment(&Segment{d,a}) {
		return false
	} 

	return true
}

func (pgn *Polygon) onBorder(p *Point) bool {
	for _, s := range pgn.horizSegments { // y is fixed
		if p.y == s.p.y && ((p.x >= s.p.x && p.x <= s.q.x) || (p.x <= s.p.x && p.x >= s.q.x)) {
			return true
		}
	} 

	for _, s := range pgn.vertSegments {  // x is fixed
		if p.x == s.p.x && ((p.y >= s.p.y && p.y <= s.q.y) || (p.y <= s.p.y && p.y >= s.q.y)) {
			return true
		}
	}

	return false
}

// Checks if a vertical or horizontal segment is contained
func (pgn *Polygon) containsSegment(s *Segment) bool {
	if s.p.x == s.q.x  { // Process vertical segments
		startY := s.p.y
		endY := s.q.y
		if s.p.y > s.q.y {
			startY = s.q.y
			endY = s.p.y
		}
		for y := startY; y <= endY; y++ {
			if !pgn.contains(&Point{s.p.x,y}) {
				return false
			}
		}
	} else { // horizontal segments
		startX := s.p.x 
		endX := s.q.x
		if s.p.x > s.q.x {
			startX = s.q.x
			endX = s.p.x
		}
		for x := startX; x <= endX; x++ {
			if !pgn.contains(&Point{x,s.p.y}) {
				return false
			}
		}
	}
	return true
}

// true if p is inside the polygon bounded by pts
func (pgn *Polygon) contains(p *Point) bool {
	if _, ok := pgn.memo[p.x]; ok {
		if _, ok := pgn.memo[p.x][p.y]; ok {
			return true
		} 
	}

	return false
}

func (pgn *Polygon) memorize(p *Point) bool {
	if _, ok := pgn.memo[p.x]; !ok {
		pgn.memo[p.x] = make(map[int]bool)
	}

	if _, ok := pgn.memo[p.x][p.y]; !ok {
			pgn.memo[p.x][p.y] = true
			return false
		}
	return true
}

// ===
// BOX
// ===
type Box struct {
	p, q *Point
}

func (b *Box) area() int {
	return (util.Abs(b.p.x-b.q.x) + 1) * (util.Abs(b.p.y-b.q.y) + 1)
}

// =======
// SEGMENT
// =======
type Segment struct {
	p, q *Point
}

func (s *Segment) onSegment(p *Point) bool {
	if s.p.x == s.q.x && p.x == s.p.x { // Vertical segment, matching x
		from := s.p.y
		to := s.q.y
		if from > to {
			from = s.q.y
			to = s.p.y
		}

		for y := from; y <= to; y++ {
			if p.y == y {
				return true
			}
		}
	}
	
	if s.p.y == s.q.y && p.y == s.p.y { // Horizontal segment, matching y
		from := s.p.x
		to := s.q.x
		if from > to {
			from = s.q.x
			to = s.p.x
		}

		for x := from; x <= to; x++ {
			if p.x == x {
				return true
			}
		}
	}
	return false
}

// =====
// POINT
// =====
type Point struct {
	x, y int
}